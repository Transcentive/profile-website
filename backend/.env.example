# Copy to .env and fill in. NEVER commit the real .env.
APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080

# PostgreSQL connection string.
DATABASE_URL=postgres://site:CHANGE_ME@127.0.0.1:5432/site?sslmode=disable

# Long random secret guarding /admin/* (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=CHANGE_ME_long_random_string

# CORS origin allowed to call the API (the public site origin).
ALLOW_ORIGIN=https://tomsherlock.space
