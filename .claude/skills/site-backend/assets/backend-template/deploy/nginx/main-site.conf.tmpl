# Main site: Nginx serves the static frontend and reverse-proxies the dynamic
# API/admin routes to the Go backend on 127.0.0.1:8080.
#
# Placeholders (substituted by scaffold_backend.py or by hand):
#   MAIN_DOMAIN  e.g. tomsherlock.space
#   SITE_ROOT    e.g. /var/www/site
#
# After installing, obtain TLS with: certbot --nginx -d MAIN_DOMAIN -d www.MAIN_DOMAIN

server {
    listen 80;
    listen [::]:80;
    server_name MAIN_DOMAIN www.MAIN_DOMAIN;

    root SITE_ROOT;
    index index.html;

    # Static frontend (hand-authored HTML/CSS/JS).
    location / {
        try_files $uri $uri/ =404;
    }

    # Dynamic API + admin handled by the Go backend.
    location /api/   { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/proxy.conf; }
    location /admin/ { proxy_pass http://127.0.0.1:8080; include /etc/nginx/snippets/proxy.conf; }
    location = /healthz { proxy_pass http://127.0.0.1:8080; access_log off; }
    location = /readyz  { proxy_pass http://127.0.0.1:8080; access_log off; }

    # Cache the static CV asset and images for a day.
    location ~* \.(?:css|js|png|jpg|jpeg|svg|webp|woff2?|pdf)$ {
        expires 1d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
